# --- Transactional email (contact form) -------------------------------------
# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives new lead notifications from the contact form.
CONTACT_EMAIL=hello@reinstategbp.com

# Verified Resend sender. Must be on a domain verified in your Resend account.
# Falls back to Resend's shared onboarding sender if unset.
RESEND_FROM_EMAIL="Reinstate GBP <noreply@reinstategbp.com>"

# --- Analytics ---------------------------------------------------------------
# Google Tag Manager container ID. Omit to disable GTM entirely (e.g. in dev).
NEXT_PUBLIC_GTM_ID=GTM-TTRT4TPM

# --- Site --------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonicals, OG tags, sitemap, RSS.
NEXT_PUBLIC_SITE_URL=https://reinstategbp.com
