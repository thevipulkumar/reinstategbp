# --- Transactional email (contact form) -------------------------------------
# The form needs ONE of the two transports below. Resend wins if both are set.
# With neither, submissions fail with a 500 and are written to the server log
# tagged CONTACT_LEAD_UNDELIVERED so they can still be recovered.

# Inbox that receives new lead notifications. Reply-To is set to the submitter,
# so replying in your mail client goes straight back to them.
CONTACT_EMAIL=hello@reinstategbp.com

# Sender address shown on outgoing mail. For SMTP this defaults to SMTP_USER.
MAIL_FROM="Reinstate GBP <hello@reinstategbp.com>"

# --- Option A: SMTP through a mailbox you already own ------------------------
# No third-party signup and no DNS verification. Port 465 uses implicit TLS,
# 587 uses STARTTLS. Values below are for Google Workspace.
#
# SMTP_PASS must be a 16-character App Password (spaces removed), NOT the
# account password — Google no longer accepts the latter over SMTP. Generate one
# after enabling 2-Step Verification on the account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hello@reinstategbp.com
SMTP_PASS=your-16-char-app-password
# Optional. Defaults to true on port 465, false elsewhere.
# SMTP_SECURE=true

# --- Option B: Resend --------------------------------------------------------
# Needs an account and a domain verified in Resend before it can mail arbitrary
# recipients. Create a key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: also send each lead to a spreadsheet or CRM -------------------
# Any endpoint that accepts a JSON POST: Google Sheets via an Apps Script web
# app, Zapier, Make, n8n, HubSpot, Airtable. Runs independently of email — one
# can fail without costing the other, and either succeeding keeps the lead safe.
# LEAD_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Sent as an X-Webhook-Secret header so the endpoint can reject anything that
# did not come from this site. Google Apps Script cannot read request headers,
# so for that destination put the secret in the URL query string instead
# (...exec?secret=xxx) and check e.parameter.secret.
# LEAD_WEBHOOK_SECRET=choose-a-long-random-string

# --- Analytics ---------------------------------------------------------------
# Google Tag Manager container ID. Omit to disable GTM entirely (e.g. in dev).
NEXT_PUBLIC_GTM_ID=GTM-TTRT4TPM

# --- Site --------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonicals, OG tags, sitemap, RSS.
NEXT_PUBLIC_SITE_URL=https://reinstategbp.com
